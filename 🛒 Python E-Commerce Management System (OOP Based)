import os

class Product :
    def __init__ (self, name, price, stock):
        self.name = name
        self.price = price
        self.stock = stock

class User:
    def __init__ (self, username, password):
        self.username = username
        self.password = password

class Store:
    def __init__ (self):
        self.products = {
        "Laptop": Product("Laptop", 800, 10),
        "phone" : Product("phone", 500, 15),
        "Headphones":
        Product("Headphones", 100, 20),
        "Keyboard" : Product("Keyboard", 50, 30)
        }
        self.users = {}
        self.cart = {}

    def register(self):
        username = input("Enter Username: ")

        if username in self.users:
            print("User already exists!")
            return

        password = input("Enter Password: ")
        self.users[username] = User(username, password)

        print("Registration Successful!")

    def login(self):
        username = input("Username: ")
        password = input("Password: ")

        if username in self.users and self.users[username].password == password:
            print(f"Welcome {username}")
            return True
        print("Invalid Login")
        return False
    def show_products(self):
        print("\n==== PRODUCTS ====")

        for product in self.products.values():
            print(
                f"Name: {product.name} | Price: ${product.price} | Stock:{product.stock}"
            )

    def add_to_cart(self):
        name = input("Product Name: ")

        if name not in self.products:
            print("Product Not Found")
            return
        
        quantity = int(input("Quantity: "))

        if quantity > self.cart[name].stock:
            print("Not Enough Stock")
            return

        if name in self.cart:
            self.cart[name] += quantity
        else:
            self.cart[name] = quantity

    def view_cart(self):
        total = 0

        print("\n===== CART =====")

        if not self.cart:
            print("Cart Is Emoty")
            return

        for item, qty in self.cart.items():
            subtotal = self.products[item].price * qty
            total += subtotal

            print(f"{item} x{qty} = ${subtotal}")

            print("=" * 30)
            print(f"TOTAL = ${total}")

    def checkout(self):
        if not self.cart:
            print("Cart Is Empty")
            return

        total = 0

        for item, qty in self.cart.items():
            self.products[item].stock -= qty 
            total += self.products[item].price * qty

        with open("orders.txt", "a") as file:
            file.write(f"New Order Total = $ {total}\n")

        print(f"Order Completed Successfully")
        print(f"Amount Paid = ${total}")

        self.cart.clear()

    def admin_panel(self):
     while True:
        print("\n===== ADMIN PANEL =====")
        print("1. Add Product")
        print("2. Delete Product")
        print("3. View Product")
        print("4. Back")

        choice = input("Choice: ")

        if choice == "1":
            name = input("Product Name: ")
            price = float(input("Price: "))
            stock = int(input("Stock: "))

            self.products[name] = Product(name, price, stock)
            print("Product Added")

        elif choice == "2":
            name = input("Product Name: ")

            if name in self.products:
                del self.products[name]
                print("Deleted Successfully")
            else:
                print("Product Not Found")

        elif choice == "3":
            self.show_products()

        elif choice == "4":
            break

